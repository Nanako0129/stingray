  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stingray.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
